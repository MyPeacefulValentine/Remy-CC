{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deep Plan Audit Output",
  "type": "object",
  "required": ["ambiguity_resolution", "pbt_specs", "logic_audit", "physical_changes", "verification_plan"],
  "properties": {
    "ambiguity_resolution": {
      "type": "array",
      "description": "Table 1: 歧义消除矩阵 (Ambiguity Resolution Matrix)",
      "items": {
        "type": "object",
        "required": ["ambiguity", "options", "fixed_constraint", "rationale"],
        "properties": {
          "ambiguity": { "type": "string", "description": "决策点/模糊项" },
          "grade": { "type": "string", "description": "决策分级（可选）：实现级/架构级（en: Implementation/Architectural）；架构级须附判据引用，参见 SKILL.md Phase 3 的 Decision Grade Reference" },
          "options": { "type": "string", "description": "可选方案" },
          "fixed_constraint": { "type": "string", "description": "最终锁定约束" },
          "rationale": { "type": "string", "description": "锁定理由" }
        }
      }
    },
    "pbt_specs": {
      "type": "array",
      "description": "Table 2: PBT 属性规约 (Property-Based Testing Spec)",
      "items": {
        "type": "object",
        "required": ["module", "property_type", "invariant", "falsification_strategy"],
        "properties": {
          "module": { "type": "string", "description": "功能模块" },
          "property_type": { "type": "string", "enum": ["Idempotency", "Round-trip", "Invariant Preservation", "Commutativity", "Bounds", "State Machine"], "description": "PBT 属性类型" },
          "invariant": { "type": "string", "description": "数学不变量描述 (e.g. f(x) > 0)" },
          "falsification_strategy": { "type": "string", "description": "证伪/测试策略" }
        }
      }
    },
    "logic_audit": {
      "type": "array",
      "description": "Table 3: 逻辑与契约审计表",
      "items": {
        "type": "object",
        "required": ["dimension", "check_item", "status", "contract"],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "数据流 (Data Flow)",
              "一致性 (Consistency)",
              "数据结构 (Data Structure)",
              "系统风险 (System Risk)",
              "复杂度 (Complexity)",
              "并发与锁 (Concurrency)",
              "零决策 (Zero-Decision)"
            ]
          },
          "check_item": { "type": "string", "description": "具体检查项" },
          "status": { "type": "string", "enum": ["Pass", "Warn", "Fail", "Locked", "Def"], "description": "审查状态" },
          "contract": { "type": "string", "description": "决策结论、规约或整改措施" }
        }
      }
    },
    "physical_changes": {
      "type": "array",
      "description": "Table 4: 物理变更预演表",
      "items": {
        "type": "object",
        "required": ["file_path", "location", "action", "summary", "scope_position", "ripple_effect"],
        "properties": {
          "file_path": { "type": "string", "description": "文件路径" },
          "location": { "type": "string", "description": "具体函数/行号" },
          "action": { "type": "string", "enum": ["Create", "Modify", "Delete"], "description": "操作类型" },
          "summary": { "type": "string", "description": "修改目的与内容简述" },
          "scope_position": { "type": "string", "description": "修改层级：以 `[标签]` 开头（zh-CN：补丁/局部修复/接口变更/跨域重构；en：Boundary-Wrap/Source-Modify/Contract-Change/Scope-Refactor），后接 1 句话说明为何此修改位于此层级。参见 SKILL.md Phase 3 的 Scope Tag Reference 表" },
          "ripple_effect": { "type": "string", "description": "涟漪效应" },
          "caller_refs": {
            "type": "array",
            "description": "调用入口列表；action='Create' 且目标为可执行代码（函数/类/模块）时必填，参见 SKILL.md Phase 4.5",
            "items": {
              "type": "object",
              "required": ["caller_file", "caller_function", "evidence_ref"],
              "properties": {
                "caller_file": { "type": "string", "description": "已存在于工作树的调用方文件路径（不可指向同 packet 中其他 Create 项的新建文件）" },
                "caller_function": { "type": "string", "description": "调用方函数名" },
                "evidence_ref": { "type": "string", "description": "指向 evidence_packet.evidence 中显示调用插入点的条目 id" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "Create" } } },
            "then": { "required": ["caller_refs"] }
          }
        ]
      }
    },
    "verification_plan": {
      "type": "array",
      "description": "Table 5: 验证计划 (Verification Plan)",
      "items": {
        "type": "object",
        "required": ["step", "method", "expected_result", "rollback_condition"],
        "properties": {
          "step": { "type": "string", "description": "验证步骤名称" },
          "method": { "type": "string", "description": "具体验证命令或操作" },
          "expected_result": { "type": "string", "description": "预期结果" },
          "rollback_condition": { "type": "string", "description": "失败时的回退条件" }
        }
      }
    }
  }
}
