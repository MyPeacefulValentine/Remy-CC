{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CIDiagnosisPacket",
  "description": "Evidence packet produced by /remy-ci, compatible with /remy-patch Phase 0.",
  "type": "object",
  "required": ["v", "task", "sender_payload", "evidence_packet"],
  "properties": {
    "v": {
      "type": "string",
      "const": "1.0.0"
    },
    "task": {
      "type": "object",
      "required": ["id", "mode", "summary", "read_only_until_evidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ci_\\d{8}_\\d{6}$"
        },
        "mode": {
          "type": "string",
          "enum": ["write", "investigate"]
        },
        "summary": {
          "type": "string",
          "maxLength": 200
        },
        "read_only_until_evidence": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "sender_payload": {
      "type": "object",
      "required": ["plan", "analysis", "assumptions"],
      "properties": {
        "plan": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "analysis": {
          "type": "string"
        },
        "assumptions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "evidence_packet": {
      "type": "object",
      "required": ["source_revision", "evidence", "proposed_changes"],
      "properties": {
        "source_revision": {
          "type": "object",
          "required": ["type", "retrieved_at"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["git", "filesystem"]
            },
            "commit": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file_type", "path", "range", "why", "status", "confidence", "excerpt"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^E-\\d{3}$"
              },
              "file_type": {
                "type": "string",
                "enum": ["source", "config", "test", "log"]
              },
              "path": {
                "type": "string"
              },
              "range": {
                "type": "object",
                "required": ["start", "end"],
                "properties": {
                  "start": { "type": "integer", "minimum": 1 },
                  "end": { "type": "integer", "minimum": 1 }
                }
              },
              "why": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["confirmed", "suspected"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "proposed_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "description", "evidence_refs"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^C-\\d{3}$"
              },
              "description": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            }
          }
        }
      }
    }
  }
}
