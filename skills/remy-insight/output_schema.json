{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Output schema for remy-insight report metadata. Defines the structure of the final report context passed to render.py.",
  "type": "object",
  "required": ["mode", "depth", "timestamp", "scope_description", "active_section_names", "agent_count", "adversarial_enabled", "sections"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["global", "focus", "compare"]
    },
    "depth": {
      "type": "string",
      "enum": ["light", "standard", "deep"]
    },
    "timestamp": {
      "type": "string",
      "description": "ISO-8601 datetime of report generation"
    },
    "scope_description": {
      "type": "string",
      "description": "Human-readable scope summary (e.g., 'Full repository' or 'Module: auth (15 files)')"
    },
    "active_section_names": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Ordered list of section names included in the report"
    },
    "agent_count": {
      "type": "object",
      "required": ["analysis", "adversarial", "total"],
      "properties": {
        "analysis": {"type": "integer", "minimum": 0},
        "adversarial": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "adversarial_enabled": {
      "type": "boolean"
    },
    "freshness_warnings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Warnings from Phase 1.3 freshness check (empty if index is fresh)"
    },
    "skipped_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "reason"],
        "properties": {
          "name": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "findings", "summary"],
        "properties": {
          "name": {"type": "string"},
          "findings": {
            "type": "array",
            "items": {"$ref": "#/$defs/finding"}
          },
          "summary": {
            "type": "string",
            "description": "Agent's overall conclusion for this analysis dimension"
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "dimension", "severity", "target", "claim", "evidence", "confidence"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "dimension": {
          "type": "string",
          "enum": ["architecture", "innovation", "improvement", "robustness", "research", "doc_consistency", "custom"]
        },
        "severity": {
          "type": "string",
          "enum": ["observation", "concern", "issue"]
        },
        "target": {
          "type": "object",
          "required": ["file"],
          "properties": {
            "file": {"type": "string"},
            "symbol": {"type": "string"},
            "layer": {"type": "string"}
          }
        },
        "claim": {
          "type": "string",
          "description": "One-sentence conclusion in REMY_LANG"
        },
        "evidence": {
          "type": "string",
          "description": "Code reference or logical derivation in REMY_LANG"
        },
        "confidence": {
          "type": "integer",
          "minimum": 2,
          "maximum": 5,
          "description": "Epistemic confidence level (2=speculation, 5=verified)"
        },
        "mechanism": {
          "type": "string",
          "description": "Technical mechanism explanation (2-5 sentences). Required for innovation/research dimensions."
        },
        "significance": {
          "type": "string",
          "description": "Engineering or academic significance (1-3 sentences). Required for innovation/research dimensions."
        },
        "verified_status": {
          "type": "string",
          "enum": ["upheld", "refuted", "inconclusive", "not_verified"],
          "description": "Result of adversarial verification (if performed)"
        },
        "vote_detail": {
          "type": "string",
          "description": "Deep mode only: vote breakdown (e.g., '2 upheld / 1 refuted')"
        },
        "cross_refs": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Cross-references to findings in other sections sharing the same target"
        }
      }
    }
  }
}
