{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "POST_VERIFY_MAX_RETRIES": "-1",
    "POST_VERIFY_EFFORT": "medium",
    "SECURITY_AUDIT_EFFORT": "medium",
    "SECURITY_AUDIT_MAX_FILTER_AGENTS": "15",
    "SECURITY_AUDIT_CONFIDENCE_THRESHOLD": "8",
    "PRECISION_READ_THRESHOLD": "500",
    "DEBUG_MAX_HYPOTHESES": "3",
    "TEST_GEN_EFFORT": "medium",
    "TEST_COVERAGE_THRESHOLD": "80",
    "TEST_COVERAGE_MAX_SUPPLEMENT_ROUNDS": "3",
    "CI_LOG_MAX_LINES": "500",
    "INSIGHT_DEFAULT_DEPTH": "standard",
    "INSIGHT_MAX_CUSTOM_ANGLES": "2",
    "INSIGHT_MAX_AGENTS": "40",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "ExitPlanMode",
      "Monitor",
      "NotebookEdit",
      "PowerShell",
      "ShareOnboardingGuide",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",
      "Skill(remy-patch)",
      "Skill(remy-debug)",
      "Skill(remy-audit)",
      "Skill(remy-plan)",
      "Skill(remy-milestone)",
      "Skill(remy-changelog)",
      "Skill(remy-tree)",
      "Skill(remy-lookup)",
      "Skill(remy-index)",
      "Skill(remy-reposcout)",
      "Skill(remy-inspect)",
      "Skill(remy-secure)",
      "Skill(remy-testgen)",
      "Skill(remy-ci)",
      "Skill(remy-insight)",
      "Bash(remy-cc summary-rebuild:*)",
      "Bash(remy-cc summary-vacuum:*)",
      "Bash(remy-cc summary-audit:*)",
      "mcp__remy-index__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Read|Glob|Grep|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/pre_tool_guard.py\""
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "__REMY_ENRICH_COMMAND__"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/env_system/enforcer_hook.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\" --resume-only"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/env_system/enforcer_hook.py\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/env_system/subagent_lang_hook.py\""
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/cwd_guard.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "__REMY_DIRTY_COMMAND__"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/permission_gate.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/permission_gate.py\""
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/permission_gate.py\""
          }
        ]
      }
    ]
  },
  "outputStyle": "system-architect",
  "switchModelsOnFlag": false,
  "spinnerTipsEnabled": true
}
