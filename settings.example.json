{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "OPENAI_API_KEY": "YOUR_API_KEY_HERE",
    "OPENAI_MODEL": "deepseek-v4-flash",
    "OPENAI_MAX_WORKERS": "3",
    "OPENAI_BASE_URL": "https://api.deepseek.com/v1/chat/completions",
    "OPENAI_RETRY_LIMIT": "3",
    "OPENAI_TIMEOUT": "300",
    "OPENAI_MAX_TOKENS": "8192",
    "PROJECT_TREE_AUTO_INJECT": "ALWAYS",
    "TIMELINE_AUTO_INJECT": "ALWAYS",
    "LOGIC_INDEX_AUTO_INJECT": "ALWAYS",
    "LOGIC_INDEX_INTERACTIVE": "true",
    "LOGIC_INDEX_FILTER_SMALL": "false",
    "REMY_LANG": "en",
    "REPO_AUDIT_ROOT": "~/claude_audit",
    "TIMELINE_INJECT_MODE": "all",
    "TIMELINE_INJECT_VALUE": "",
    "POST_VERIFY_MAX_RETRIES": "-1",
    "POST_VERIFY_EFFORT": "medium",
    "SECURITY_AUDIT_EFFORT": "medium",
    "SECURITY_AUDIT_MAX_FILTER_AGENTS": "15",
    "SECURITY_AUDIT_CONFIDENCE_THRESHOLD": "8",
    "IMPACT_DEPTH_UP": "2",
    "IMPACT_DEPTH_DOWN": "2",
    "PRECISION_READ_THRESHOLD": "500",
    "DEBUG_MAX_HYPOTHESES": "3",
    "STRUCT_SCAN_TIMEOUT": "60",
    "TEST_GEN_EFFORT": "medium",
    "TEST_COVERAGE_THRESHOLD": "80",
    "TEST_COVERAGE_MAX_SUPPLEMENT_ROUNDS": "3",
    "CI_LOG_MAX_LINES": "500",
    "INSIGHT_DEFAULT_DEPTH": "standard",
    "INSIGHT_MAX_CUSTOM_ANGLES": "2",
    "INSIGHT_MAX_AGENTS": "30",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Agent",
      "Edit",
      "ExitPlanMode",
      "Glob",
      "Grep",
      "Monitor",
      "NotebookEdit",
      "PowerShell",
      "Read",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskUpdate",
      "TaskStop",
      "CronCreate",
      "CronDelete",
      "CronList",
      "WebFetch",
      "WebSearch",
      "Write",
      "Skill(remy-patch)",
      "Skill(remy-debug)",
      "Skill(remy-audit)",
      "Skill(remy-plan)",
      "Skill(remy-milestone)",
      "Skill(remy-changelog)",
      "Skill(remy-tree)",
      "Skill(remy-lookup)",
      "Skill(remy-index)",
      "Skill(remy-reposcout)",
      "Skill(remy-inspect)",
      "Skill(remy-secure)",
      "Skill(remy-testgen)",
      "Skill(remy-ci)",
      "Skill(remy-insight)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Read|Glob|Grep|Bash|PowerShell|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/pre_tool_guard.py\""
          }
        ]
      },
      {
        "matcher": "Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/logic_enrichment_hook.py\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/env_system/enforcer_hook.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\""
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/tree_system/lifecycle_hook.py\" --resume-only"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"~/.claude/hooks/logic_dirty_tracker.py\""
          }
        ]
      }
    ]
  },
  "outputStyle": "system-architect",
  "spinnerTipsEnabled": true
}
